{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Cleaner",
  "version": "2.0.0-alpha.1",
  "identifier": "com.da0101.mac-cleaner",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Mac Cleaner",
        "width": 1120,
        "height": 760,
        "minWidth": 840,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
